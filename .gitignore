# milhouse run bookkeeping — regenerated every run, safe to delete.
.milhouse/runs/

# Python
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/

# Tooling caches
.pytest_cache/
.ruff_cache/
.pyright/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Beads audit log. Local only: it is an append-only agent trail, not issue data,
# so every concurrent commit conflicts on the end of the file. Issues live in
# Dolt and sync with `bd dolt push`.
.beads/interactions.jsonl
